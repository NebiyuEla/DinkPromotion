# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dinkpromotion?schema=public"

# Public app URL, e.g. https://promotion.example.com
APP_URL="https://example.com"
NEXT_PUBLIC_APP_NAME="Dink Promotion"
NEXT_PUBLIC_SUPPORT_URL=""

# Telegram Mini App + bot
TELEGRAM_BOT_TOKEN=""
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_TELEGRAM_IDS="123456789"

# PRM4U
PRM4U_API_KEY=""
PRM4U_API_URL="https://prm4u.com/api/v2"
# New synced services stay disabled until pricing is configured unless both values below are set.
PRICING_USD_ETB_RATE=""
DEFAULT_MARKUP_PERCENT=""

# Payments
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""
CHAPA_MODE="test"
# Customer-facing processing fee added to direct order payments. Change in Vercel when needed.
PAYMENT_PROCESSING_FEE_PERCENT="2.875"
# Direct-charge guardrails. Defaults match the current merchant method limits.
CHAPA_DIRECT_MIN_ETB="1"
CHAPA_TELEBIRR_MAX_ETB="75000"
CHAPA_CBEBIRR_MAX_ETB="150000"

# Background sync endpoint
CRON_SECRET="replace-with-a-long-random-value"
